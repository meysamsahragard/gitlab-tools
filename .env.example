# Personal, project, or group access token with the read_api scope.
# GitLab: Preferences → Access Tokens.
GITLAB_TOKEN=

# API port. The dev server proxies /api here.
PORT=3001

# Optional overrides. The project URL lives in config/default.json.
# GITLAB_BASE_URL=http://gitlab.corp.mabnadp.com
# CLIENT_ORIGIN=http://localhost:5173
# HOST=127.0.0.1
